{
  "name": "needle-kit",
  "type": "module",
  "version": "3.6.1",
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
  "description": "Arya's needle, little but powerful.",
  "author": "magicdawn",
  "license": "MIT",
  "homepage": "https://github.com/magicdawn/needle-kit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magicdawn/needle-kit.git"
  },
  "bugs": {
    "url": "https://github.com/magicdawn/needle-kit/issues"
  },
  "keywords": [
    "needle",
    "kit"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist/",
    "package.json"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "prepare": "husky",
    "test:dev": "vitest",
    "test-cover": "vitest run --coverage",
    "dev": "tsdown --watch",
    "build": "tsdown",
    "prepublishOnly": "pnpm test && pnpm build",
    "typeswrong": "attw --pack .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@humanfs/node": "^0.16.8",
    "@magicdawn/finder-sort": "^0.4.0",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.4",
    "memoize": "^11.0.0",
    "micromatch": "^4.0.8",
    "path-type": "^6.0.0",
    "shell-escape": "^0.2.0",
    "untildify": "^6.0.0"
  },
  "devDependencies": {
    "@magicdawn/eslint-config": "^1.6.5",
    "@magicdawn/prettier-config": "^0.1.0",
    "@types/fs-extra": "^11.0.4",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^25.6.0",
    "@types/shell-escape": "^0.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "lint-staged": {
    "*": [
      "eslint --fix --no-warn-ignored",
      "prettier --write --ignore-unknown"
    ]
  }
}
